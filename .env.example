# Postgres connection string. Neon: use the *pooled* URL, e.g.
# postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/festival_pos?sslmode=require
DATABASE_URL=

# At least 32 random characters, signs the login cookies. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Protects /api/cron/sweep (Vercel Cron sends it as Bearer token). Any random string.
CRON_SECRET=

# Optional. Leave empty: cookies then belong to the current host, which also
# keeps Vercel preview URLs working. Only set for a shared parent domain.
COOKIE_DOMAIN=

# Optional. Absolute URL printed into table QR codes. Defaults to the URL the
# admin uses when generating the PDF. Set it once you have a custom domain.
NUXT_PUBLIC_APP_URL=

# Optional. Passkeys belong to a domain; by default the one the app runs on.
# Only set to pin it, e.g. WEBAUTHN_RP_ID=pos.verein.de and
# WEBAUTHN_ORIGIN=https://pos.verein.de
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Local development / CI only: talk to plain Postgres over TCP instead of the
# Neon WebSocket driver.
# DB_DRIVER=pg
